
# middleMDM Server Configuration
# Copy this to .env and update values for your environment

# Flask settings
FLASK_ENV=production
SECRET_KEY=

# Database
# SQLite (development/debug?????????????????????????????????? idk kilo code/claude/copilot did this)
DATABASE_URL=sqlite:///./middlemdm_dev.db
# PostgreSQL (production)
# DATABASE_URL=postgresql://user:password@localhost/middlemdm

# Server binding
HOST=127.0.0.1
PORT=5001

# Device enrollment
ENROLLMENT_SECRET=

# Session security
SESSION_COOKIE_SECURE=true

# Logging
LOG_LEVEL=INFO
