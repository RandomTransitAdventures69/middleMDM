# middleMDM Server Configuration
# Copy this to .env and update values for your environment

# Flask settings
FLASK_ENV=development
SECRET_KEY=change-this-to-a-random-secret-key-in-production

# Database
# SQLite (development)
DATABASE_URL=sqlite:///./middlemdm_dev.db
# PostgreSQL (production)
# DATABASE_URL=postgresql://user:password@localhost/middlemdm

# Server binding
HOST=0.0.0.0
PORT=5000

# Device enrollment
ENROLLMENT_SECRET=change-this-enrollment-secret

# Session security
SESSION_COOKIE_SECURE=false  # Set to true if using HTTPS

# Logging
LOG_LEVEL=INFO
